PORT=4000
# URL de PostgreSQL local. En Render, usa el Internal Database URL de tu base.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edunova
# Actívalo solo si usas una URL de conexión externa que requiera SSL.
DATABASE_SSL=false
# Orígenes del frontend permitidos por CORS, separados por coma (local y desplegado)
WEB_ORIGIN=http://localhost:3000
